generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ChiefAdmin {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String?
  googleId      String?  @unique
  provider      String   @default("LOCAL") // LOCAL, GOOGLE
  avatar        String?
  adminPassword String?
  hotelName     String?  @default("SmartResto")
  hotelAddress  String?
  hotelPhone    String?
  hotelGst      String?
  upiId         String?
  upiName       String?
  role                  String    @default("WAITER") // ADMIN, WAITER, KITCHEN, CASHIER
  isLocked              Boolean   @default(false)
  planName              String    @default("Basic Plan")
  isTrial               Boolean   @default(true)
  trialDays             Int       @default(2)
  trialExpiresAt        DateTime?
  monthlyFee            Float     @default(1000)
  subscriptionMonths    Int       @default(1)
  discountAmount        Float     @default(0)
  totalPayable          Float     @default(1000)
  isPaid                Boolean   @default(false)
  subscriptionExpiresAt DateTime?
  lastPaidAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  orders        Order[]  @relation("WaiterOrders")
  userOrders    Order[]  @relation("UserOrders")
  payments      Payment[]
  userPayments  Payment[] @relation("UserPayments")
  tables        Table[]
  categories    Category[]
  foodItems     FoodItem[]
}

model SystemSettings {
  id                        String   @id @default("default")
  defaultPlanName           String   @default("Basic Plan")
  defaultMonthlyFee         Float    @default(1000)
  defaultSubscriptionMonths Int      @default(1)
  defaultDiscountAmount     Float    @default(0)
  defaultTrialDays          Int      @default(2)
  updatedAt                 DateTime @updatedAt
}

model Table {
  id          String   @id @default(uuid())
  tableNumber Int
  capacity    Int      @default(4)
  status      String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING
  qrToken     String?  @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
  feedbacks   Feedback[]

  @@unique([userId, tableNumber])
  @@index([userId])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  description String?
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItems   FoodItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model FoodItem {
  id           String      @id @default(uuid())
  name         String
  description  String?
  price        Float
  prepTime     Int         @default(15) // in minutes
  availability Boolean     @default(true)
  isVeg        Boolean     @default(true)
  image        String?
  ingredients  String?
  isPopular    Boolean     @default(false)
  spicyLevel   Int         @default(0) // 0: None, 1: Mild, 2: Medium, 3: Spicy
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id                  String      @id @default(uuid())
  orderNumber         String      @unique
  tokenNumber         Int
  customerName        String
  customerId          String?
  customer            Customer?   @relation(fields: [customerId], references: [id])
  tableId             String
  table               Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiterId            String?
  waiter              User?       @relation("WaiterOrders", fields: [waiterId], references: [id], onDelete: SetNull)
  userId              String?
  user                User?       @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  status              String      @default("PENDING") // PENDING, ACCEPTED, PREPARING, READY, SERVED, COMPLETED, PAID, CANCELLED
  orderSource         String      @default("WAITER") // WAITER, QR
  customerType        String      @default("REGULAR") // REGULAR, WAITER_CUSTOMER, QR_CUSTOMER
  numberOfPersons     Int?
  sessionId           String?
  totalAmount         Float       @default(0)
  taxAmount           Float       @default(0)
  discountAmount      Float       @default(0)
  grandTotal          Float       @default(0)
  specialInstructions String?
  orderTime           DateTime    @default(now())
  readyTime           DateTime?
  servedTime          DateTime?
  completedTime       DateTime?
  items               OrderItem[]
  payment             Payment?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([userId])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  foodItemId String
  foodItem   FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1)
  unitPrice  Float
  notes      String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashierId     String?
  cashier       User?    @relation(fields: [cashierId], references: [id])
  userId        String?
  user          User?    @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod String   @default("CASH") // CASH, UPI, CREDIT_CARD, DEBIT_CARD, WALLET, SPLIT
  subtotal      Float
  tax           Float
  discount      Float    @default(0)
  grandTotal    Float
  paidAmount    Float
  balance       Float    @default(0)
  transactionId String?
  cashierName   String
  createdAt     DateTime @default(now())

  @@index([userId])
}

model Notification {
  id         String   @id @default(uuid())
  title      String
  message    String
  roleTarget String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Feedback {
  id            String   @id @default(uuid())
  tableId       String
  table         Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  orderId       String?
  ratingFood    Int      @default(5)
  ratingService Int      @default(5)
  comments      String?
  customerName  String?
  createdAt     DateTime @default(now())

  @@index([tableId])
}

